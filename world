<!DOCTYPE html>
<html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>STARPATH </title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Space+Grotesk:wght@500;600&family=IBM+Plex+Mono:wght@400&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap">
<style>
:root{color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#04060d;--bg2:#080c18;--pn:#0c1222;--ink:#e6edff;--sub:#8a97b8;--ln:#1f2c48;--cy:#46e6ff;--vi:#a06bff;--pk:#a06bff;--gd:#ffd27a;
--hd:"Cinzel","Noto Sans KR",serif;--lb:"Space Grotesk","Noto Sans KR",sans-serif;--sn:"Noto Sans KR",system-ui,sans-serif;--mo:"IBM Plex Mono",ui-monospace,Menlo,monospace}
*,*:before,*:after{box-sizing:inherit;scrollbar-width:thin;scrollbar-color:var(--cy) #0a0f22}
::-webkit-scrollbar{width:8px;height:8px}::-webkit-scrollbar-track{background:#0a0f22}
::-webkit-scrollbar-thumb{background:linear-gradient(var(--cy),var(--vi));border-radius:4px}::-webkit-scrollbar-thumb:hover{background:var(--cy)}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 64px)}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sn);font-weight:300;line-height:1.75;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:50;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(70,230,255,.022) 0 1px,transparent 1px 3px)}
.wrap{max-width:980px;margin:0 auto;padding:0 22px}
nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:20;height:58px;background:linear-gradient(#04060df2,#04060d00);backdrop-filter:blur(3px)}
nav .wrap{height:100%;display:flex;align-items:center;gap:22px;max-width:1120px}
nav b{font:700 16px var(--hd);letter-spacing:.3em;color:var(--cy);margin-right:auto;text-shadow:0 0 12px var(--cy)}
nav a{color:var(--ink);opacity:.7;text-decoration:none;font:500 13px var(--sn);letter-spacing:.08em;transition:.2s}
nav a:hover,nav a:focus-visible{opacity:1;color:var(--cy);outline:none}
.hero{min-height:100svh;display:grid;place-items:center;text-align:center;position:relative;overflow:hidden;background:radial-gradient(ellipse 70% 55% at 50% 40%,#16205a 0%,transparent 70%),radial-gradient(ellipse 50% 40% at 85% 85%,#2e1250 0%,transparent 70%),var(--bg)}
#sky{position:absolute;inset:0;width:100%;height:100%}
.ring{position:absolute;left:50%;top:46%;width:min(92vw,760px);aspect-ratio:1;translate:-50% -50%;border:1px solid #46e6ff33;border-radius:50%;animation:spin 60s linear infinite}
.ring:before{content:"";position:absolute;inset:9%;border:1px dashed #a06bff44;border-radius:50%}
.ring:after{content:"";position:absolute;top:-4px;left:50%;width:8px;height:8px;background:var(--cy);border-radius:50%;box-shadow:0 0 16px 4px var(--cy)}
@keyframes spin{to{rotate:360deg}}
.hero .in{position:relative;z-index:1;padding:90px 22px 110px;animation:rise 1.3s cubic-bezier(.2,.7,.2,1) both}
@keyframes rise{from{opacity:0;transform:translateY(22px)}}
.eyebrow{font:500 13px var(--lb);letter-spacing:.3em;color:var(--cy);margin-bottom:18px}
.hero h1{font:900 clamp(44px,12vw,138px)/1 var(--hd);margin:0;letter-spacing:.08em;background:linear-gradient(180deg,#fff 20%,#7fdcff 60%,#a06bff);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 34px rgba(70,230,255,.35))}
.slogan{font-size:clamp(18px,3.4vw,28px);font-weight:500;margin:22px 0 8px;letter-spacing:.08em}.slogan em{font-style:normal;color:var(--gd)}
.theme{max-width:42ch;margin:0 auto 34px;color:var(--sub);font-size:clamp(14px,2.2vw,16px)}
.btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.btn{display:inline-block;color:var(--ink);text-decoration:none;font:600 14px var(--lb);letter-spacing:.2em;padding:16px 38px;border:1px solid var(--cy);background:linear-gradient(90deg,#46e6ff30,#a06bff18);clip-path:polygon(16px 0,100% 0,calc(100% - 16px) 100%,0 100%);transition:.25s}
.btn.g{border-color:#ffffff44;background:none;color:var(--sub)}
.btn:hover,.btn:focus-visible{background:var(--cy);color:#04060d;outline:none;box-shadow:0 0 30px #46e6ff77}
section.s{padding:62px 0;position:relative;border-top:1px solid var(--ln)}
.hd{margin-bottom:26px}
.hd span{font:600 11.5px var(--lb);letter-spacing:.35em;color:var(--cy)}
.hd h2{font-weight:700;font-size:clamp(21px,3.2vw,28px);margin:4px 0 0}
.hd p{color:var(--sub);margin:8px 0 0;max-width:62ch;font-size:13.5px}
.hd:after{content:"";display:block;width:44px;height:2px;margin-top:14px;background:linear-gradient(90deg,var(--cy),var(--vi))}
.lore{display:grid;grid-template-columns:5fr 7fr;gap:36px;align-items:start}
.lore blockquote{margin:0;font-size:clamp(16px,2.3vw,20px);font-weight:500;line-height:1.75;border-left:2px solid var(--cy);padding-left:16px}
.lore blockquote small{display:block;margin-top:10px;font:500 11px var(--lb);letter-spacing:.2em;color:var(--sub)}
.lore p{margin:0 0 11px;color:#b6c0dc;font-size:13.5px;line-height:1.75}.lore p b{color:var(--gd);font-weight:500}
.lore .mys{color:var(--sub);font-style:italic;border-top:1px dashed var(--ln);padding-top:11px}
.lore .note{margin:14px 0 0;font-size:11.5px;color:var(--sub);opacity:.85}
.sub2{margin:34px 0 10px;font-size:15px;font-weight:700;color:var(--gd)}
.tabs{display:flex;gap:4px 22px;flex-wrap:wrap;margin-bottom:18px;border-bottom:1px dashed var(--ln)}
.tabs button{background:none;border:0;border-bottom:2px solid transparent;color:var(--sub);font:600 12.5px var(--lb);letter-spacing:.14em;padding:8px 2px;cursor:pointer;transition:.2s;margin-bottom:-1px}
.tabs button:hover{color:var(--cy)}.tabs button[aria-selected=true],.tabs button.on{color:var(--cy);border-color:var(--cy)}
.tabs button:focus-visible{outline:2px solid var(--gd);outline-offset:2px}
.pane{display:grid;grid-template-columns:5fr 7fr;gap:30px;animation:rise .4s both}
.pane h3{font-size:24px;font-weight:900;margin:0}.pane .en{font:600 11px var(--hd);letter-spacing:.3em;color:var(--vi)}
.pane p{color:#b6c0dc;margin:10px 0 0;font-size:13.5px;line-height:1.7}
.pane .core{display:inline-block;margin-top:12px;color:var(--gd);font-size:12.5px;border-bottom:1px dotted var(--gd)}
.zl{margin:0;padding:0;list-style:none;border-top:1px solid var(--ln);align-content:start}
.zl li{padding:10px 4px;border-bottom:1px dashed var(--ln);display:grid;grid-template-columns:54px 1fr;gap:10px;font-size:13px}
.zl li b{font:600 11px var(--lb);color:var(--cy);align-self:center;letter-spacing:.08em}.zl li span{color:#b6c0dc}.zl li em{font-style:normal;color:var(--pk);font-size:11px;margin-left:6px}
.rows{list-style:none;margin:0;padding:0;border-top:1px solid var(--ln)}
.rows li{border-bottom:1px dashed var(--ln)}.rows li:last-child{border-bottom:1px solid var(--ln)}
.row{all:unset;box-sizing:border-box;width:100%;display:grid;grid-template-columns:92px minmax(160px,.8fr) 1.5fr 24px;align-items:center;gap:18px;padding:17px 12px;cursor:pointer;position:relative;transition:background .2s,padding .2s}
.row:before{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--cy);box-shadow:0 0 12px var(--cy);transform:scaleY(0);transition:transform .25s}
.row:hover,.row:focus-visible{background:linear-gradient(90deg,#46e6ff1a,transparent 75%);padding-left:20px}
.row:hover:before,.row:focus-visible:before{transform:scaleY(1)}.row:focus-visible{outline:2px solid var(--gd);outline-offset:-2px}
.row .t{font-size:12px;color:var(--vi);font-weight:500}.row b{font-weight:700;font-size:16.5px;transition:color .2s}.row:hover b{color:var(--cy)}
.row .d{color:var(--sub);font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .a{color:var(--cy);text-align:right;opacity:0;transform:translateX(-6px);transition:.2s}.row:hover .a,.row:focus-visible .a{opacity:1;transform:none}
dialog{border:0;padding:0;background:transparent;color:var(--ink);width:min(560px,calc(100vw - 32px));max-height:none;margin:auto;overflow:visible}
dialog::backdrop{background:rgba(2,4,10,.82);backdrop-filter:blur(5px)}dialog[open]{animation:rise .25s both}
.md{position:relative;background:#0a1020;border-top:2px solid var(--cy);border-bottom:1px dashed var(--cy);padding:28px 28px 22px;max-height:84vh;overflow:auto;box-shadow:0 20px 60px -20px #46e6ff55}
.md .t{font-size:12px;color:var(--vi);font-weight:500}.md h3{font-size:clamp(21px,4vw,26px);font-weight:900;margin:4px 0 14px}
.md p{margin:0 0 7px;color:#c3cce4;font-weight:400;font-size:13.5px;line-height:1.45}.md p.sm{font-size:12px;color:var(--sub);font-weight:300}
.md .x{position:absolute;top:6px;right:8px;width:44px;height:44px;background:none;border:0;color:var(--sub);font-size:26px;cursor:pointer}
.md .x:hover,.md .x:focus-visible{color:var(--cy);outline:none}
ruby{ruby-position:over}rt{font-size:.58em;color:var(--cy);font-weight:500}
.cl{padding:12px 0;border-top:1px dashed var(--ln)}.cl:first-child{border-top:0;padding-top:0}
.cl .ch{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 10px}.cl b{font-size:16px}.cl em{font-style:normal;color:var(--gd);font-size:13px}.cl .ty{margin-left:auto;font:600 11px var(--lb);color:var(--vi);letter-spacing:.1em}
.cl p{margin:4px 0 0!important;font-size:13px!important}.cl .pt{color:var(--sub)!important;font-size:12px!important}.cl .pt i{font-style:normal;color:var(--cy);margin-left:6px}
.sbj dt{color:var(--gd);font:600 12px var(--lb);letter-spacing:.15em;margin-top:10px}.sbj dd{margin:0;color:#c3cce4;font-size:13.5px}
/* 슬라이드 공통 */
.sw{position:relative;overflow:hidden}
.ar{position:absolute;top:50%;translate:0 -50%;width:52px;height:88px;background:none;border:0;color:#fff;opacity:.7;cursor:pointer;z-index:2;transition:opacity .2s,transform .2s;display:grid;place-items:center;padding:0;filter:drop-shadow(0 0 5px #000a)}.ar svg{width:14px;height:28px;display:block}
.ar:hover,.ar:focus-visible{opacity:1;outline:none}.ar.l:hover{transform:translate(-3px,0)}.ar.r:hover{transform:translate(3px,0)}.ar.l{left:4px}.ar.r{right:4px}
.sld{position:relative;min-height:400px;overflow:hidden;border-top:1px solid var(--ln);border-bottom:1px solid var(--ln);background:#05081a;display:flex;align-items:center}
.sld .bg,.sld .bg svg,.sld .bg img{position:absolute;inset:0;width:100%;height:100%;display:block}.sld .bg img{object-fit:cover}.sld .bg img.e0{transform:translateX(24%)}.sld .bg img.e1{object-position:right center}.sld .bg img.e2{transform:translateX(14%)}
.sld:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,#04060df2 0,#04060dd8 34%,#04060d66 62%,transparent 90%)}
.sld .ar{z-index:3}
.sd{position:relative;z-index:2;padding:32px 58px;max-width:580px;animation:rise .4s both}
.sd .k{font:600 12px var(--lb);letter-spacing:.3em;color:var(--cy)}
.sd h3{font:900 clamp(32px,5vw,46px)/1.1 var(--sn);margin:6px 0 8px;text-shadow:0 2px 18px #000}
.sd .tg{color:var(--gd);font-size:15px;font-weight:500;margin:0 0 16px;text-shadow:0 1px 10px #000}
.sd ol{margin:0;padding:0;list-style:none;counter-reset:n}
.sd li{counter-increment:n;display:grid;grid-template-columns:30px 1fr;padding:9px 0;border-top:1px dashed #46e6ff66;font-size:14.5px;line-height:1.5;color:#f2f5ff;font-weight:400;text-shadow:0 1px 8px #000}
.sd li:before{content:"0" counter(n);font:600 12px var(--lb);color:var(--cy);padding-top:3px}
.dots{position:absolute;left:0;right:0;bottom:12px;display:flex;gap:6px;justify-content:center;z-index:3}.dots i{width:22px;height:3px;background:#ffffff44}.dots i.on{background:var(--cy)}
.hd .la{font:700 clamp(24px,4.4vw,36px)/1.2 var(--hd);letter-spacing:.22em;margin:4px 0 0;color:var(--ink);text-shadow:0 0 18px #46e6ff40}.hd .la em{font-style:normal;color:var(--gd);text-shadow:0 0 18px #ffd27a40}
.hd p.qs{border-left:2px solid var(--cy);padding-left:12px;font-style:italic;margin-top:12px}
/* 길드 */
.gn{display:flex;gap:2px 18px;overflow-x:auto;padding-bottom:6px;border-bottom:1px solid #ffffff1f;margin-bottom:22px}
.gn button{flex:none;background:none;border:0;border-bottom:2px solid transparent;color:var(--sub);padding:6px 1px;font:500 12.5px var(--sn);cursor:pointer;margin-bottom:-1px}
.gn button:hover{color:var(--ink)}.gn button.on{color:var(--cy);border-color:var(--cy)}
.gw{display:grid;grid-template-columns:230px 1fr;gap:34px;animation:rise .4s both}
.pf{position:relative;aspect-ratio:3/4;background:linear-gradient(160deg,#16205a,#0a0f22);overflow:hidden}
.pf:before,.pf:after{content:"";position:absolute;width:22px;height:22px;z-index:1;pointer-events:none}
.pf:before{top:0;left:0;border-top:2px solid var(--cy);border-left:2px solid var(--cy)}.pf:after{bottom:0;right:0;border-bottom:2px solid var(--cy);border-right:2px solid var(--cy)}
.pf img{width:100%;height:100%;object-fit:cover;display:block}
.pf .q{position:absolute;inset:0;display:grid;place-items:center;font:700 56px var(--lb);color:#ffffff26}
.gh{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}.gh h3{margin:0;font-size:26px;font-weight:900}
.tag{font:600 11px var(--lb);letter-spacing:.2em;padding:2px 9px 2px 11px;border:1px solid;border-color:color-mix(in srgb,currentColor 55%,transparent);background:color-mix(in srgb,currentColor 10%,transparent)}
.gj{margin:14px 0 4px;padding:10px 0;border-top:1px solid var(--ln);border-bottom:1px solid var(--ln);display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.gj small{font:600 10.5px var(--lb);letter-spacing:.25em;color:var(--gd)}.gj b{font-size:22px;font-weight:900}
.wn{margin:0;display:grid;grid-template-columns:96px 1fr}
.wn dt,.wn dd{margin:0;padding:8px 0;border-bottom:1px solid #ffffff14;font-size:13.5px;line-height:1.55}
.wn dt{font:600 11px var(--lb);letter-spacing:.14em;color:var(--cy);padding-top:10px}.wn dd{color:#c3cbe4}
@media(max-width:800px){.sld .bg img.e0,.sld .bg img.e2{transform:none}.sld{min-height:500px;align-items:flex-end}.sld:before{background:linear-gradient(0deg,#04060df5 0,#04060ddd 58%,#04060d55 100%)}.sd{padding:24px 40px 42px}nav a:nth-child(n+6){display:none}nav .wrap{gap:14px}.lore,.pane,.sld,.gw{grid-template-columns:1fr;gap:20px}section.s{padding:48px 0}.art{min-height:130px}.gw .pf{max-width:200px}
.row{grid-template-columns:1fr 18px;gap:1px 10px;padding:14px 6px}.row .t{grid-column:1/-1}.row .d{white-space:normal}.row .a{grid-row:2/4;grid-column:2;opacity:.6;transform:none}.wn{grid-template-columns:78px 1fr}}
.qt{margin:0;border-left:2px solid var(--cy);padding-left:16px;font:500 clamp(12.5px,1.9vw,18px)/1.7 var(--sn);white-space:nowrap}
.qt small{display:block;margin-top:6px;font:500 11px var(--lb);letter-spacing:.2em;color:var(--sub)}
.wv{max-width:68ch;margin-top:22px}.wv p{margin:0 0 11px;color:#b6c0dc;font-size:13.5px;line-height:1.75}.wv b{color:var(--gd);font-weight:500}
.wv .mys{color:var(--sub);font-style:italic}
.wv .srv{margin:16px 0 0;padding:10px 0;border-top:1px dashed var(--ln);border-bottom:1px dashed var(--ln);color:#c3cce4}
.wv .srv b{font:700 14px var(--sn);letter-spacing:.04em;color:var(--gd)}
.wv .note{margin:12px 0 0;font-size:11.5px;color:var(--sub)}
.sys{font:400 12.5px/1.8 var(--mo)!important;color:var(--cy)!important}
.hd p.sys{color:var(--cy)}.scan{margin:18px 0 0;padding-top:12px;border-top:1px dashed var(--ln)}.scan:after{content:"▌";animation:bl 1s steps(1) infinite}
.nt{margin:6px 0 0;font-size:11.5px;color:var(--sub)}
.sy{list-style:none;margin:0;padding:0;border-top:1px solid var(--ln)}
.sy li{display:grid;grid-template-columns:150px 1fr;gap:18px;padding:14px 4px;border-bottom:1px dashed var(--ln);align-items:baseline}
.sy li:last-child{border-bottom:1px solid var(--ln)}
.sy b{font-size:16px}.sy b small{display:block;font:600 11px var(--lb);letter-spacing:.2em;color:var(--vi)}
.sy em{display:block;font:600 12px var(--sn);font-style:normal;color:var(--cy);letter-spacing:.08em;margin-bottom:2px}.sy span{display:block;color:#b6c0dc;font-size:13.5px;line-height:1.6}
@media(max-width:800px){.qt{white-space:normal}.sy li{grid-template-columns:1fr;gap:2px}}
.gt{border-bottom:0;margin:12px 0 2px}
.gwb .gj{display:flex;flex-direction:column;align-items:flex-start;gap:0;margin:16px 0 0;padding:18px 0 0;border:0;border-top:1px solid #ffffff1f}
.gwb .gj .uc{font:600 10px var(--lb);letter-spacing:.3em;color:var(--gd);border:1px solid #ffd27a80;padding:3px 9px 3px 11px;margin-bottom:10px}
.gwb .gj b{font-size:30px;line-height:1.15;font-weight:900;color:#fff}
.gwb .gj em{font:600 12.5px var(--lb);font-style:normal;letter-spacing:.32em;text-transform:uppercase;color:var(--cy);margin-top:7px}
.sg{margin:12px 0 0;font:400 15.5px/1.6 var(--sn);color:#aeb9d6}
.mq{margin:8px 0 0;font:400 14.5px/1.55 var(--sn);color:#cdd6ee}
.sp{margin:18px 0 0;display:grid;grid-template-columns:64px 1fr;border:1px solid var(--ln);background:#46e6ff08}
.sp dt,.sp dd{margin:0;padding:9px 14px;border-bottom:1px solid #ffffff12;font-size:13.5px;line-height:1.55}
.sp dt{font:600 11px var(--lb);letter-spacing:.16em;color:var(--cy);padding-top:11px}
.sp dd{color:#e6edff}.sp dt:last-of-type,.sp dd:last-of-type{border-bottom:0}
.gx{list-style:none;margin:16px 0 0;padding:14px 0 0;border-top:1px dashed #ffffff45}
.gx li{padding:0 0 3px;color:#eef2ff;font-weight:500;font-size:14.5px;line-height:1.5}
.gt button svg{width:12px;height:12px;margin-left:7px;vertical-align:-1px;color:var(--gd)}
.pf img.bl{filter:blur(16px) brightness(.55);transform:scale(1.1)}
.rn{display:flex;align-items:center;flex-wrap:wrap;gap:8px 8px;margin:20px 0 4px;padding-bottom:14px;border-bottom:1px solid #ffffff1f}.rn b{font:700 19px/1.3 var(--sn);color:#fff;margin-right:6px}.rn span{font:600 12px var(--sn);letter-spacing:.04em;color:var(--cy);border:1px solid #46e6ff55;background:#46e6ff0f;padding:3px 11px}
.lk{margin-top:22px;padding:34px 20px;border:1px solid var(--ln);background:#46e6ff08;text-align:center}
.lk svg{width:30px;height:30px;color:var(--gd)}
.lk .lt{margin:12px 0 6px;font:600 12px var(--lb);letter-spacing:.3em;color:var(--gd)}
.lk .ld{margin:0 0 20px;font-size:14.5px;line-height:1.65;color:#dfe6fa}
.lk .la{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.lk .la button{background:none;border:1px solid #ffffff44;color:#dfe6fa;padding:9px 20px;font:500 13px var(--sn);cursor:pointer;transition:.2s}
.lk .la button:hover{border-color:var(--cy);color:var(--cy)}
.lk .la .go{border-color:var(--gd);color:var(--gd)}.lk .la .go:hover{background:var(--gd);color:#04060d;border-color:var(--gd)}
/* TERMINAL */
.term{max-width:640px;margin:0 auto;padding:26px;border:1px solid var(--cy);background:#050a14;font:400 14px/2 var(--mo);color:var(--cy);min-height:230px;box-shadow:0 0 40px -10px #46e6ff77}
.term .ok{color:#fff;font-family:var(--sn);font-weight:500}.cur:after{content:"▌";animation:bl 1s steps(1) infinite}@keyframes bl{50%{opacity:0}}
footer{padding:44px 22px 60px;color:var(--sub);font-size:12px;line-height:1.9;border-top:1px solid var(--ln);background:#02040a}
footer .wrap{display:grid;gap:10px}footer .lg{font:900 15px var(--hd);letter-spacing:.3em;color:var(--cy)}
footer .ln{display:flex;flex-wrap:wrap;gap:4px 20px}footer .ln a{color:var(--ink);opacity:.8;text-decoration:none;font-size:13px}footer a:hover{color:var(--cy)}footer a{color:var(--sub)}footer small{display:block;opacity:.75;font-size:11.5px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
